# Production Supabase credentials for backup/sync scripts.
# Copy to `.env.production` in the repo root (gitignored).
#
# Used by: npm run backup, npm run sync:local, npm run sync:staging

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_production_secret_key
SUPABASE_PROJECT_REF=your_project_ref
SUPABASE_DB_PASSWORD=your_db_password
# Optional override; otherwise restore builds the URL from PROJECT_REF + DB_PASSWORD
# SUPABASE_DB_URL=postgresql://postgres:your_db_password@db.your_project_ref.supabase.co:5432/postgres
