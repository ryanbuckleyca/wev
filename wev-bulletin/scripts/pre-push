#!/usr/bin/env bash
# Git pre-push hook.
# Intentionally does NOT run database migrations.
# Migrations should run in the deploy pipeline, not on developer push.
# Install: cp scripts/pre-push .git/hooks/pre-push && chmod +x .git/hooks/pre-push

set -euo pipefail

REPO_ROOT="$(git rev-parse --show-toplevel)"
cd "${REPO_ROOT}"

while read -r local_ref local_sha remote_ref remote_sha; do
  if [[ "${remote_ref}" = "refs/heads/main" ]]; then
    echo "INFO: Skipping DB migrations on push to main (handled during deploy)."
  fi
done
