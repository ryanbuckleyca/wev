NODE_ENV=example

##########
# shared #
##########

SUPABASE_DB_PASSWORD=your_db_password
SUPABASE_PROJECT_REF=your_project_ref
SUPABASE_SECRET_KEY=your_secret_key
SUPABASE_URL=your_supabase_url
# Optional: explicit postgres URL for restore sequence reset. If unset, restore
# builds one from SUPABASE_DB_PASSWORD + SUPABASE_PROJECT_REF (or uses the
# reset_restore_identity_sequences RPC via the secret key).
# SUPABASE_DB_URL=postgresql://postgres:your_db_password@db.your_project_ref.supabase.co:5432/postgres

################
# wev-bulletin #
################

# CV import (/api/cv/extract) requires GROQ_API_KEY and JINA_API_KEY (see wev-scraper below).

NEXT_PUBLIC_ENV_MODE=local
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=your_next_public_supabase_url
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_next_public_supabase_publishable_key
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
# Google Analytics — only set in production; omit locally to disable tracking
NEXT_PUBLIC_GA_MEASUREMENT_ID=

PLAYWRIGHT_BASE_URL=http://localhost:3000

# captcha from Cloudflare (Turnstile test keys)
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# for triggering workflow actions from bulletin
WEV_GITHUB_TOKEN=your_github_token

REVALIDATION_SECRET=your_revalidation_secret
MAILSLURP_API_KEY=your_mailslurp_api_key

###############
# wev-scraper #
###############

USE_PROD_DB=0
ENV_MODE=local
EMAIL_PASSWORD=your_email_password
MAX_JOBS_PER_PAGE=25
WITHIN_WEEKS=2
SHOULD_OVERRIDE_EXISTING=0
SHOULD_CLASSIFY=1
SHOULD_RE_CLASSIFY=0
SHOULD_GEOCODE=1
SHOULD_RE_GEOCODE=0
SHOULD_SUMMARIZE=1
SHOULD_RE_SUMMARIZE=0
SHOULD_TAG_VALUES=1
SHOULD_RE_TAG_VALUES=0
# ESCO / Jina vectorize for SSE jobs only (is_sse=true). skills_raw is always via unified processor.
SHOULD_TAG_SKILLS=1
SHOULD_RE_TAG_SKILLS=0

GEOCODIO_API_KEY=your_geocodio_api_key

# Headcount Labs jobs API (optional source: --source headcount)
# Create a key at https://api.headcountlabs.com/data/keys
HEADCOUNTLABS_API_KEY=your_headcountlabs_api_key
# HEADCOUNTLABS_BASE_URL=https://api.headcountlabs.com
# Offline sample (no API key): path to Headcount job JSON array or {data:[...]}
# HEADCOUNTLABS_SAMPLE_PATH=../scratch/headcountlabs-sample-jobs-2026-10-14.json

# Adzuna Jobs API (optional; Canada via /jobs/ca/search/{page})
# Register at https://developer.adzuna.com/
# Note: descriptions are snippets (~500 chars) — weak for SSE/ESCO.
ADZUNA_APP_ID=your_adzuna_app_id
ADZUNA_APP_KEY=your_adzuna_app_key

# ---------------------------------------------------------------------------
# Canada job APIs — cost waterfall (broad CA ingest; is_sse is post-filter)
#   0. Niche scrapers (owned)
#   1. serpapi     — Google Jobs, CA-wide (cheapest quota)
#   2. apify       — Apify Job Bank actor (unique federal inventory)
#   3. thejobsapi  — ATS / career pages only
#   4. theirstack  — Indeed + LinkedIn gap-fill only (exclude ATS hosts)
# Headcount (when signup works) can replace/augment tier 3.
# ---------------------------------------------------------------------------

# SerpApi — Google Jobs only (not Glassdoor engine)
# https://serpapi.com/google-jobs-api
SERPAPI_API_KEY=your_serpapi_api_key
# SERPAPI_GOOGLE_JOBS_LOCATION=Canada
# SERPAPI_GOOGLE_JOBS_GL=ca
# SERPAPI_GOOGLE_JOBS_HL=en
# Neutral volume queries to page Google's CA index (not SSE keywords):
# SERPAPI_GOOGLE_JOBS_QUERIES=hiring,job,full time,part time,remote,contract,permanent,temporary,internship
# SERPAPI_GOOGLE_JOBS_MAX_PAGES=3
# SERPAPI_GOOGLE_JOBS_MAX_ITEMS=200
# SERPAPI_GOOGLE_JOBS_SAMPLE_PATH=../scratch/serpapi-google-jobs-field-audit.json

# Apify — Canada Job Bank actor (slug ``apify``; getascraper/jobbank-scraper)
# Token: https://console.apify.com/account/integrations
APIFY_API_TOKEN=your_apify_api_token
APIFY_JOBBANK_ACTOR=getascraper/jobbank-scraper
# APIFY_JOBBANK_MAX_ITEMS=50
# APIFY_JOBBANK_SAMPLE_PATH=../scratch/apify-jobbank-getascraper-sample-3.json
# JOBBANK_SAMPLE_PATH=  # legacy alias for APIFY_JOBBANK_SAMPLE_PATH

# The Jobs API — CA ATS / employer career pages (tier 3)
# Docs: https://thejobsapi.com/docs — Bearer tja_live_…
# Recency: /v1/jobs ``window`` (1h|24h|7d|30d|6m). Default maps WITHIN_WEEKS
# (≤1→7d, ≤4→30d, else 6m). Override with TJA_WINDOW.
TJA_API_KEY=your_thejobsapi_key
# THEJOBSAPI_KEY=
# TJA_COUNTRY=CA
# TJA_SOURCES=workday,greenhouse,icims,dayforce,lever,ashby,bamboohr
# TJA_WINDOW=30d
# TJA_MAX_ITEMS=50
# TJA_SAMPLE_PATH=../scratch/tja-ca-details-20.json

# TheirStack — CA Indeed/LinkedIn only (tier 4 gap-fill; 1 credit/job)
THEIRSTACK_API_KEY=your_theirstack_api_key
# THEIRSTACK_COUNTRY=CA
# THEIRSTACK_URL_DOMAIN_OR=indeed.com,ca.indeed.com,linkedin.com
# THEIRSTACK_URL_DOMAIN_NOT=greenhouse.io,lever.co,myworkdayjobs.com,workdayjobs.com,ashbyhq.com,bamboohr.com,icims.com,smartrecruiters.com,dayforcehcm.com,jobvite.com,workable.com,recruitee.com,applytojob.com
# THEIRSTACK_POSTED_AT_MAX_AGE_DAYS=14
# THEIRSTACK_MAX_ITEMS=50
# THEIRSTACK_SAMPLE_PATH=../scratch/theirstack-ca-sample.json

GEMINI_API_KEY=your_gemini_api_key
# SSE / org assessment chain (optional overrides):
# GEMINI_SSE_PRIMARY_MODEL=gemini-3.6-flash
# GEMINI_SSE_LITE_MODEL=gemini-3.5-flash-lite
# USE_GOOGLE_SEARCH_GROUNDING — Tavily-only by default: unset|0 = off;
#   1 = force Google Search on Gemini (explicit escape hatch)
GROQ_API_KEY=your_groq_api_key
# Skill phrase extraction prompt variant (v3|v5|v11). Default: v5.
# SKILLS_RAW_PROMPT_VARIANT=v5

# Local LLMs for categorization and vector embedding
LOCAL_LLM_MODEL=llama3.2:3b
# OLLAMA_NUM_PREDICT=900
# OLLAMA_MAX_PROMPT_CHARS=10000
JINA_API_KEY=your_jina_api_key
TAVILY_API_KEY=your_tavily_api_key # shared evidence for Gemini/Groq/Ollama SSE
# TAVILY_MAX_RESULTS=5
# TAVILY_SEARCH_DEPTH=basic
# TAVILY_MAX_CHARS=4500
# TAVILY_OLLAMA_MAX_CHARS=1800
# TAVILY_TIMEOUT_SEC=30            # per-request search timeout; fail soft into SSE chain
# TAVILY_MAX_RETRIES=2             # retries after first failure (0–5)
# MAX_GROUNDED_PROMPT_CHARS=100000  # Gemini/Groq combined prompt+evidence cap (head+tail)
