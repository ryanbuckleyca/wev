###############
# wev-scraper #
###############

USE_PROD_DB=0
ENV_MODE=local
EMAIL_PASSWORD=your_email_password # ryan's gmail for outbound smtp
# MAX_JOBS_PER_PAGE=1
WITHIN_WEEKS=2
SHOULD_OVERRIDE_EXISTING=0
SHOULD_CLASSIFY=1
SHOULD_RE_CLASSIFY=0
SHOULD_GEOCODE=1
SHOULD_RE_GEOCODE=0
SHOULD_SUMMARIZE=1
SHOULD_RE_SUMMARIZE=0
SHOULD_TAG_VALUES=1
SHOULD_RE_TAG_VALUES=0
SHOULD_TAG_SKILLS=1
SHOULD_RE_TAG_SKILLS=0

GEOCODIO_API_KEY=your_geocodio_api_key

