# Playwright and local development both use `.env` for the dedicated wev-test database.
# Copy this file to `.env` when setting up the app locally.

# Optional for Playwright; it can be derived from SUPABASE_URL.
# Keep it set if you also use migration and type-generation scripts directly.
SUPABASE_PROJECT_REF=your-wev-test-project-ref
SUPABASE_URL=https://your-wev-test-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-wev-test-service-role-key
NEXT_PUBLIC_SUPABASE_URL=https://your-wev-test-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-wev-test-publishable-key
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3001

# E2E Email Provider Configuration
# Use 'mailpit' for local development (requires Mailpit running on localhost:8025)
# Use 'mailslurp' for staging/CI (requires MAILSLURP_API_KEY)
E2E_EMAIL_PROVIDER=mailpit
# MAILPIT_API_URL=http://localhost:8025 (optional, defaults to this)
# MAILSLURP_API_KEY=your-mailslurp-api-key (required only if using mailslurp)
